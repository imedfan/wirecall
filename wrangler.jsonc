{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wirecall",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-10",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "TURN_ENABLED": "false",
    "ROOM_TTL_SECONDS": "1209600",
    "ALLOWED_ORIGINS": ""
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDurableObject" },
      { "name": "ROOM_INDEX", "class_name": "RoomIndexDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject", "RoomIndexDurableObject"]
    }
  ]
}
